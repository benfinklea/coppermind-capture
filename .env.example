# API key for authenticating capture requests (generate with: python -c "import secrets; print(secrets.token_urlsafe(32))")
CAPTURE_API_KEY=change-me

# Path to the Coppermind installation
COPPERMIND_PATH=/workspace/coppermind

# Host and port for the capture API
CAPTURE_HOST=0.0.0.0
CAPTURE_PORT=8033
